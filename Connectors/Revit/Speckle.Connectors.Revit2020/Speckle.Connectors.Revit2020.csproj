<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWpf>true</UseWpf>
    <RevitVersion>2020</RevitVersion>
    <DefineConstants>$(DefineConstants);REVIT2020</DefineConstants>
    <Configurations>Debug;Release;Local</Configurations>
  </PropertyGroup>

  <PropertyGroup Label="Things needed to get ancient cef buildling with modern msbuild">
    <!--There is a weird bug or misconfiguration in cef 65.0.1 nuget that makes it pick x86 dlls if asked to build x64.-->
    <!--Asking it to build AnyCPU appaers to work, but generates MSB3270 warnings, which we are ignoring here-->
    <!--Official docs suggest setting the entire solution to x64, which we can't do, and we don't want to create a new SLN just for Revit 2020-->
    <CefSharpAnyCpuSupport>true</CefSharpAnyCpuSupport>
    <Prefer32bit>false</Prefer32bit>
    <ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
  </PropertyGroup>

  <Import Project="..\Speckle.Connectors.RevitShared\Speckle.Connectors.RevitShared.projitems" Label="Shared" />

  <Import Project="..\Speckle.Connectors.RevitShared.Cef\Speckle.Connectors.RevitShared.Cef.projitems" Label="Shared" />

  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Net.Http" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Converters\Revit\Speckle.Converters.Revit2020\Speckle.Converters.Revit2020.csproj" />
    <ProjectReference Include="..\..\..\DUI3\Speckle.Connectors.DUI\Speckle.Connectors.DUI.csproj" />
    <!--
      Revit.Common references Speckle.Revit.API 2022 which would shadow the Revit 2020 API
      (both assemblies share the simple name "RevitAPI", so the newer one wins and hides types
      like UnitType that were removed in 2022). Exclude its transitive compile assets so the
      connector resolves the Revit 2020 API coming from the converter reference instead.
    -->
    <ProjectReference
      Include="..\Speckle.Connectors.Revit.Common\Speckle.Connectors.Revit.Common.csproj"
      ExcludeAssets="compile"
    />
  </ItemGroup>

  <ItemGroup>
    <!--
      CefSharp 65 (same as the fork's Revit 2022 build, era-appropriate for Revit 2020):
      - built with the VS2017 toolchain, so it loads with the VC++ 2015-2017 runtime present on
      Revit 2020 machines (CefSharp 92 needs the VS2019 runtime -> FileLoadException on load);
      - same CEF generation as the Chinese addins (建模大师 etc.) that already initialize CEF
      in the Revit process, so both can coexist;
      - full assets so the native files (libcef.dll, locales, ...) land in the plugin output.
    -->
    <PackageReference Include="CefSharp.Wpf" NoWarn="NU1903, NU1902" VersionOverride="65.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Plugin\Speckle.Connectors.Revit2020.addin">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
